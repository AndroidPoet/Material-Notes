CREATE TABLE Note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL DEFAULT '',
    backround INTEGER NOT NULL DEFAULT 0,
    content TEXT NOT NULL DEFAULT ''
);

selectAll:
SELECT * FROM Note ORDER BY id DESC;

selectById:
SELECT * FROM Note WHERE id = ?;

insertNote:
INSERT INTO Note(title, date, backround, content)
VALUES (?, ?, ?, ?);

updateNote:
UPDATE Note SET title = ?, date = ?, backround = ?, content = ? WHERE id = ?;

-- Insert-or-replace by primary key. Used when pulling notes down from Supabase so a
-- remote note keeps its server-assigned id instead of getting a fresh local one.
upsertNote:
INSERT OR REPLACE INTO Note(id, title, date, backround, content)
VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM Note WHERE id = ?;
